# Copy this file to .env and fill in all values before running docker-compose up.
#
# NOTE: DB / MinIO / RabbitMQ credentials are baked into their docker volumes on
# first init. Changing them later requires `docker compose down -v` (wipes data).

# ══ URLs PUBLIQUES — le seul bloc qui change entre le poste local et le serveur ══
# Les URLs internes (keycloak:8080, app-backend:8080, …) restent figées dans le compose : elles ne
# changent jamais. Ci-dessous, ce sont les valeurs que voient les navigateurs et les téléphones.
#
# Tout passe désormais par une origine unique — le nginx de admin-app — sur /api, /auth, /files
# et /ws. Il n'y a donc plus de port de service à publier ni à annoncer.
#
# Émetteur des jetons, tel que le navigateur l'atteint. Doit correspondre exactement à l'origine
# servie, protocole compris : une valeur restée en http:// alors que le serveur répond en https://
# fait rejeter tous les jetons, avec une erreur qui parle d'émetteur et non de protocole.
# LOCAL : http://localhost/auth/realms/asm     SERVEUR : https://<adresse>/auth/realms/asm
PUBLIC_KEYCLOAK_URL=http://localhost/auth/realms/asm
# Origine de l'application d'administration.
# LOCAL : http://localhost                      SERVEUR : https://<adresse>
PUBLIC_URL=http://localhost
# Origines acceptées par la passerelle, séparées par des virgules. Sans objet tant que tout est
# servi depuis la même origine ; utile pour le serveur Vite de développement sur le port 5173.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ── Database passwords ────────────────────────────────────────────────────────
APP_DB_PASS=
DELIVERY_DB_PASS=
DRIVER_DB_PASS=

# ── Keycloak ──────────────────────────────────────────────────────────────────
# Postgres password for Keycloak's own database
KC_DB_PASS=
# Initial admin credentials for the Keycloak master-realm console
KC_ADMIN_PASSWORD=

# ── RabbitMQ ──────────────────────────────────────────────────────────────────
RABBITMQ_USER=
RABBITMQ_PASS=

# ── MinIO ─────────────────────────────────────────────────────────────────────
MINIO_USER=
MINIO_PASS=
# LAISSER VIDE. Renseignée, cette valeur est figée dans chaque lien de photo produit ; vide, le
# service déduit l'origine de la requête (X-Forwarded-Host) et les liens suivent d'eux-mêmes le
# navigateur, le téléphone ou le serveur. Une adresse IP écrite ici cesse d'être joignable au
# premier changement de réseau, et les images deviennent des cadres vides.
MINIO_PUBLIC_URL=

# ── Odoo ERP (leave blank to skip ERP sync) ───────────────────────────────────
ODOO_URL=
ODOO_DB=
ODOO_UID=
ODOO_PASSWORD=

# ── OAuth2 client secrets ─────────────────────────────────────────────────────
CLIENT_SECRET_APP=
CLIENT_SECRET_DELIVERY=
CLIENT_SECRET_DRIVER=
CLIENT_SECRET_ERP=
CLIENT_SECRET_GW=

# ── AES field encryption (any string; SHA-256'd to a 256-bit key internally) ──
AES_ENCRYPTION_KEY=

# ── Assistant (RAG) — fournisseurs de modèles ─────────────────────────────────
# Celui qui n'est pas sélectionné reste câblé comme secours automatique.
# Valeurs acceptées : gemini | openai
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# Utilisé quand LLM_PROVIDER=openai — la clé vaut aussi pour OpenRouter.
OPENAI_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-oss-20b:free

# ── Email (Resend) ────────────────────────────────────────────────────────────
# Generate at https://resend.com/api-keys
RESEND_API_KEY=

# ── Gateway security settings ──────────────────────────────────────────────────
# Set to 'true' to allow downstream services to trust headers forwarded by the API Gateway
TRUST_GATEWAY_HEADERS=false
# A unique static secret token matched between API Gateway and microservices
GATEWAY_SECRET=
# Shared secret gating the inbound Odoo→ASM webhook (ErpAdapterService)
ERP_WEBHOOK_SECRET=
