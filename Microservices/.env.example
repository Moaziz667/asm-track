# Copy this file to .env and fill in all values before running docker-compose up.

# ── Database passwords ────────────────────────────────────────────────────────
APP_DB_PASS=
DELIVERY_DB_PASS=
DRIVER_DB_PASS=

# ── RabbitMQ ──────────────────────────────────────────────────────────────────
RABBITMQ_USER=
RABBITMQ_PASS=

# ── MinIO ─────────────────────────────────────────────────────────────────────
MINIO_USER=
MINIO_PASS=

# ── Odoo ERP ──────────────────────────────────────────────────────────────────
ODOO_DB=
ODOO_UID=
ODOO_PASSWORD=

# ── OAuth2 client secrets ─────────────────────────────────────────────────────
CLIENT_SECRET_APP=
CLIENT_SECRET_DELIVERY=
CLIENT_SECRET_DRIVER=
CLIENT_SECRET_ERP=
CLIENT_SECRET_GW=

# ── Auth server RSA seed ───────────────────────────────────────────────────────
AUTH_RSA_SEED=

# ── Email (Resend) ────────────────────────────────────────────────────────────
# Generate at https://resend.com/api-keys
RESEND_API_KEY=

# ── Gateway security settings ──────────────────────────────────────────────────
# Set to 'true' to allow downstream services to trust headers forwarded by the API Gateway
TRUST_GATEWAY_HEADERS=false
# A unique static secret token matched between API Gateway and microservices
GATEWAY_SECRET=

