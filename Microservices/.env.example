# Copy this file to .env and fill in all values before running docker-compose up.
#
# NOTE: DB / MinIO / RabbitMQ credentials are baked into their docker volumes on
# first init. Changing them later requires `docker compose down -v` (wipes data).

# ══ PUBLIC-FACING URLs — the ONLY block you change between local and the dev server ══
# Internal docker URLs (keycloak:8080, app-backend:8080, …) stay hardcoded in compose — they
# never change. These are the values clients/browsers see, so they must match the host.
#
# Public Keycloak issuer the admin app + services use (browser-reachable). LOCAL: localhost:8089.
PUBLIC_KEYCLOAK_URL=http://localhost:8089/realms/asm
# Admin web origin — used by scripts/kc-apply-public-url.sh to set Keycloak redirect/CORS.
PUBLIC_URL=http://localhost:5173
# Browser origins the gateway allows (admin + driver-web dev). Comma-separated.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:5000

# ── Database passwords ────────────────────────────────────────────────────────
APP_DB_PASS=
DELIVERY_DB_PASS=
DRIVER_DB_PASS=

# ── Keycloak ──────────────────────────────────────────────────────────────────
# Postgres password for Keycloak's own database
KC_DB_PASS=
# Initial admin credentials for the Keycloak master-realm console
KC_ADMIN_PASSWORD=

# ── RabbitMQ ──────────────────────────────────────────────────────────────────
RABBITMQ_USER=
RABBITMQ_PASS=

# ── MinIO ─────────────────────────────────────────────────────────────────────
MINIO_USER=
MINIO_PASS=
# Must be reachable from clients — embedded in POD/file links (e.g. http://<host>:9000)
MINIO_PUBLIC_URL=

# ── Odoo ERP (leave blank to skip ERP sync) ───────────────────────────────────
ODOO_URL=
ODOO_DB=
ODOO_UID=
ODOO_PASSWORD=

# ── OAuth2 client secrets ─────────────────────────────────────────────────────
CLIENT_SECRET_APP=
CLIENT_SECRET_DELIVERY=
CLIENT_SECRET_DRIVER=
CLIENT_SECRET_ERP=
CLIENT_SECRET_GW=

# ── AES field encryption (any string; SHA-256'd to a 256-bit key internally) ──
AES_ENCRYPTION_KEY=

# ── Email (Resend) ────────────────────────────────────────────────────────────
# Generate at https://resend.com/api-keys
RESEND_API_KEY=

# ── Gateway security settings ──────────────────────────────────────────────────
# Set to 'true' to allow downstream services to trust headers forwarded by the API Gateway
TRUST_GATEWAY_HEADERS=false
# A unique static secret token matched between API Gateway and microservices
GATEWAY_SECRET=
# Shared secret gating the inbound Odoo→ASM webhook (ErpAdapterService)
ERP_WEBHOOK_SECRET=
