# Configuration Lombok commune aux six services et a asm-tenant-core.
#
# Lombok ecrit getters, setters, equals, hashCode, toString et classes Builder a la place du
# developpeur. JaCoCo, lui, instrumente le bytecode : ces methodes generees etaient donc comptees
# dans le denominateur de la couverture, et jamais couvertes. Sur DeliveryMicroservice, 126 des 340
# classes de src/main portent une annotation Lombok, ce qui suffit a ecraser le pourcentage.
#
# addLombokGeneratedAnnotation pose @lombok.Generated sur tout ce que Lombok produit. JaCoCo ignore
# depuis sa version 0.8 les methodes portant une annotation nommee Generated. Le taux ne mesure donc
# plus que le code effectivement ecrit.
#
# stopBubbling declare ce repertoire comme racine : Lombok cesse de chercher un fichier de
# configuration dans les repertoires parents, ce qui rend le comportement identique sur un poste de
# developpement et dans la chaine d'integration.
config.stopBubbling = true
lombok.addLombokGeneratedAnnotation = true
