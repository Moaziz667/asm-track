# QueryShopify — environment variables
# Copy this file to .env and fill in your Shopify credentials.

# Your Shopify store URL (no trailing slash)
# Example: https://my-store.myshopify.com
SHOPIFY_STORE_URL=https://your-store.myshopify.com

# Private app Admin API access token
SHOPIFY_ACCESS_TOKEN=your_access_token_here
