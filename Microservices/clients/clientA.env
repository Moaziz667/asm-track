# ──────────────────────────────────────────────────────────────
# CLIENT A — Odoo (real) + Shopify (test mode)
#
# Start:
#   docker compose \
#     -f docker-compose.shared.yml \
#     -f docker-compose.odoo.yml \
#     -f docker-compose.shopify.yml \
#     --env-file clients/clientA.env up -d
#
# First run — create the DB:
#   docker exec mapper-postgres psql -U mapper -c "CREATE DATABASE mapper_clientA;"
# ──────────────────────────────────────────────────────────────

# ── Database (isolated per client) ──────────────────────────
DB_NAME=mapper_clienta

# ── Odoo credentials ─────────────────────────────────────────
# host.docker.internal resolves to the host machine from inside Docker
ODOO_URL=http://host.docker.internal:8069/jsonrpc
ODOO_DB=ODOODB
ODOO_UID=2
ODOO_PASSWORD=tp1ODOO

# ── Shopify — TEST MODE (no real store, use POST /orders/test) 
# Leave SHOPIFY_STORE_URL empty → QueryShopify serves in-memory test orders
SHOPIFY_STORE_URL=
SHOPIFY_ACCESS_TOKEN=

# ── Warehouse (origin — hardcoded, never queried from ERP) ───
WAREHOUSE_NAME=Main Warehouse
WAREHOUSE_FULL_ADDRESS=123 Logistics Street, Zone Industrielle
WAREHOUSE_CITY=Algiers
WAREHOUSE_POSTAL_CODE=16000
WAREHOUSE_COUNTRY_CODE=DZ

# ── Sync interval ────────────────────────────────────────────
SYNC_INTERVAL_MS=30000

# ── GitLab token (required to pull @asm/canonical-model during docker build)
# Generate at: GitLab → Edit profile → Access Tokens → scope: api
GITLAB_TOKEN=glpat-m_EfRvJD9OQ8WeHXctt_Z286MQp1OmRxYjV1Cw.01.121z04f3t
