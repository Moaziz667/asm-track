# ──────────────────────────────────────────────────────────────
# CLIENT B — Odoo only
#
# Usage:
#   docker compose \
#     -f docker-compose.shared.yml \
#     -f docker-compose.odoo.yml \
#     --env-file clients/clientB.env \
#     up -d
#
# Before first run, create the database:
#   docker exec mapper-postgres psql -U mapper -c "CREATE DATABASE mapper_clientB;"
# ──────────────────────────────────────────────────────────────

# ── Database ────────────────────────────────────────────────
DB_NAME=mapper_clientB

# ── Odoo credentials ─────────────────────────────────────────
ODOO_URL=https://clientb.odoo.com
ODOO_DB=clientb_production
ODOO_UID=2
ODOO_PASSWORD=change_me

# ── Warehouse (origin — never queried from ERP) ──────────────
WAREHOUSE_NAME=ClientB Main Warehouse
WAREHOUSE_FULL_ADDRESS=456 Industrial Avenue
WAREHOUSE_CITY=Oran
WAREHOUSE_POSTAL_CODE=31000
WAREHOUSE_COUNTRY_CODE=DZ

# ── Sync ────────────────────────────────────────────────────
SYNC_INTERVAL_MS=60000
