{
  "realm": "asm",
  "enabled": true,
  "displayName": "ASM Track",
  "displayNameHtml": "<b>ASM Track</b>",
  "registrationAllowed": false,
  "registrationEmailAsUsername": false,
  "rememberMe": false,
  "verifyEmail": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "failureFactor": 5,
  "waitIncrementSeconds": 60,
  "maxFailureWaitSeconds": 900,
  "minimumQuickLoginWaitSeconds": 60,
  "quickLoginCheckMilliSeconds": 1000,
  "maxDeltaTimeSeconds": 43200,
  "accessTokenLifespan": 300,
  "accessTokenLifespanForImplicitFlow": 900,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "offlineSessionIdleTimeout": 2592000,
  "offlineSessionMaxLifespan": 5184000,
  "accessCodeLifespan": 60,
  "accessCodeLifespanUserAction": 900,
  "accessCodeLifespanLogin": 1800,
  "actionTokenGeneratedByAdminLifespan": 43200,
  "actionTokenGeneratedByUserLifespan": 300,
  "oauth2DeviceCodeLifespan": 600,
  "oauth2DevicePollingInterval": 5,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,
  "sslRequired": "none",
  "roles": {
    "realm": [
      {
        "name": "offline_access",
        "description": "${role_offline-access}",
        "composite": false,
        "clientRole": false,
        "attributes": {}
      },
      {
        "name": "uma_authorization",
        "description": "${role_uma_authorization}",
        "composite": false,
        "clientRole": false,
        "attributes": {}
      },
      {
        "name": "ADMIN",
        "description": "Platform administrator",
        "composite": true,
        "composites": {
          "realm": [
            "perm:user:manage", "perm:driver:manage", "perm:driver:view",
            "perm:route:view", "perm:route:manage", "perm:route:validate",
            "perm:delivery:view", "perm:delivery:manage", "perm:dispatch:operate",
            "perm:erp:sync", "perm:erp:config", "perm:report:view",
            "perm:audit:view", "perm:settings:manage", "perm:company:manage"
          ]
        },
        "clientRole": false
      },
      {
        "name": "DISPATCHER",
        "description": "Logistics dispatcher",
        "composite": true,
        "composites": {
          "realm": [
            "perm:driver:view",
            "perm:route:view", "perm:route:manage", "perm:route:validate",
            "perm:delivery:view", "perm:delivery:manage", "perm:dispatch:operate",
            "perm:erp:sync", "perm:report:view", "perm:audit:view"
          ]
        },
        "clientRole": false
      },
      {
        "name": "MANAGER",
        "description": "Read-only manager",
        "composite": true,
        "composites": {
          "realm": ["perm:route:view", "perm:delivery:view", "perm:report:view"]
        },
        "clientRole": false
      },
      {
        "name": "DRIVER",
        "description": "Delivery driver",
        "composite": false,
        "clientRole": false
      },
      {
        "name": "CLIENT",
        "description": "End-client placing orders",
        "composite": false,
        "clientRole": false
      },
      {
        "name": "SERVICE",
        "description": "Internal service account",
        "composite": false,
        "clientRole": false
      },
      { "name": "perm:user:manage",      "description": "Manage admin/dispatcher/manager users", "composite": false, "clientRole": false },
      { "name": "perm:driver:manage",    "description": "Invite/edit/suspend drivers",          "composite": false, "clientRole": false },
      { "name": "perm:driver:view",      "description": "View drivers",                         "composite": false, "clientRole": false },
      { "name": "perm:route:view",       "description": "View routes",                          "composite": false, "clientRole": false },
      { "name": "perm:route:manage",     "description": "Build/edit routes",                    "composite": false, "clientRole": false },
      { "name": "perm:route:validate",   "description": "Validate/start/close routes",          "composite": false, "clientRole": false },
      { "name": "perm:delivery:view",    "description": "View deliveries",                      "composite": false, "clientRole": false },
      { "name": "perm:delivery:manage",  "description": "Edit/dispatch deliveries",             "composite": false, "clientRole": false },
      { "name": "perm:dispatch:operate", "description": "Operate the dispatch desk",            "composite": false, "clientRole": false },
      { "name": "perm:erp:sync",         "description": "Trigger ERP import/sync",              "composite": false, "clientRole": false },
      { "name": "perm:erp:config",       "description": "Configure ERP connection",             "composite": false, "clientRole": false },
      { "name": "perm:report:view",      "description": "View stats/reports/analytics",         "composite": false, "clientRole": false },
      { "name": "perm:audit:view",       "description": "View audit logs",                      "composite": false, "clientRole": false },
      { "name": "perm:settings:manage",  "description": "Manage system settings",               "composite": false, "clientRole": false },
      { "name": "perm:company:manage",   "description": "Manage company profile/branding",      "composite": false, "clientRole": false },
      {
        "name": "default-roles-asm",
        "description": "${role_default-roles}",
        "composite": true,
        "composites": {
          "realm": ["offline_access", "uma_authorization"],
          "client": { "account": ["view-profile", "manage-account"] }
        },
        "clientRole": false
      }
    ]
  },
  "defaultRole": {
    "name": "default-roles-asm",
    "description": "${role_default-roles}",
    "composite": true,
    "clientRole": false
  },
  "components": {
    "org.keycloak.userprofile.UserProfileProvider": [
      {
        "providerId": "declarative-user-profile",
        "config": {
          "kc.user.profile.config": [
            "{\"attributes\":[{\"name\":\"username\",\"displayName\":\"${username}\",\"validations\":{\"length\":{\"min\":3,\"max\":255},\"username-prohibited-characters\":{},\"up-username-not-idn-homograph\":{}},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"email\",\"displayName\":\"${email}\",\"validations\":{\"email\":{},\"length\":{\"max\":255}},\"required\":{\"roles\":[\"user\"]},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\"]},\"multivalued\":false},{\"name\":\"firstName\",\"displayName\":\"${firstName}\",\"validations\":{\"length\":{\"max\":255},\"person-name-prohibited-characters\":{}},\"required\":{\"roles\":[\"user\"]},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"lastName\",\"displayName\":\"${lastName}\",\"validations\":{\"length\":{\"max\":255},\"person-name-prohibited-characters\":{}},\"required\":{\"roles\":[\"user\"]},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false}],\"groups\":[{\"name\":\"user-metadata\",\"displayHeader\":\"User metadata\",\"displayDescription\":\"Attributes, which refer to user metadata\"}],\"unmanagedAttributePolicy\":\"ENABLED\"}"
          ]
        }
      }
    ]
  },
  "clients": [
    {
      "clientId": "admin-web",
      "name": "Admin Web Application",
      "enabled": true,
      "publicClient": true,
      "frontchannelLogout": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "authorizationServicesEnabled": false,
      "redirectUris": [
        "http://localhost:5173/*",
        "http://localhost/*"
      ],
      "webOrigins": [
        "http://localhost:5173",
        "http://localhost"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "+",
        "backchannel.logout.url": "http://app-backend:8080/api/auth/backchannel-logout",
        "backchannel.logout.session.required": "true",
        "backchannel.logout.revoke.offline.tokens": "false"
      },
      "protocol": "openid-connect",
      "fullScopeAllowed": true,
      "protocolMappers": [
        {
          "name": "app_user_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "app_user_id",
            "claim.name": "app_user_id",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "driver-app",
      "name": "Driver Mobile Application",
      "enabled": true,
      "publicClient": true,
      "frontchannelLogout": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "authorizationServicesEnabled": false,
      "redirectUris": [
        "asm://callback",
        "com.asm.driverapp://login-callback"
      ],
      "webOrigins": [
        "http://localhost:5000"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "backchannel.logout.url": "http://app-backend:8080/api/auth/backchannel-logout",
        "backchannel.logout.session.required": "true",
        "backchannel.logout.revoke.offline.tokens": "false"
      },
      "protocol": "openid-connect",
      "fullScopeAllowed": true,
      "protocolMappers": [
        {
          "name": "app_user_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "app_user_id",
            "claim.name": "app_user_id",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "phone",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "phone",
            "claim.name": "phone",
            "jsonType.label": "String",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "app-backend",
      "name": "AppBackend Service",
      "enabled": true,
      "publicClient": false,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "authorizationServicesEnabled": false,
      "secret": "${CLIENT_SECRET_APP}",
      "protocol": "openid-connect",
      "fullScopeAllowed": true
    },
    {
      "clientId": "delivery-service",
      "name": "Delivery Microservice",
      "enabled": true,
      "publicClient": false,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "authorizationServicesEnabled": false,
      "secret": "${CLIENT_SECRET_DELIVERY}",
      "protocol": "openid-connect",
      "fullScopeAllowed": true
    },
    {
      "clientId": "driver-service",
      "name": "Driver Service",
      "enabled": true,
      "publicClient": false,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "authorizationServicesEnabled": false,
      "secret": "${CLIENT_SECRET_DRIVER}",
      "protocol": "openid-connect",
      "fullScopeAllowed": true
    },
    {
      "clientId": "erp-adapter",
      "name": "ERP Adapter Service",
      "enabled": true,
      "publicClient": false,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "authorizationServicesEnabled": false,
      "secret": "${CLIENT_SECRET_ERP}",
      "protocol": "openid-connect",
      "fullScopeAllowed": true
    },
    {
      "clientId": "api-gateway",
      "name": "API Gateway",
      "enabled": true,
      "publicClient": false,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "authorizationServicesEnabled": false,
      "secret": "${CLIENT_SECRET_GW}",
      "protocol": "openid-connect",
      "fullScopeAllowed": true
    }
  ],
