# Admin web (Vite) — copy to .env.local and fill for your environment (local OR dev server),
# then REBUILD (`npm run build`). Vite bakes these into the bundle at build time — there is no
# runtime swap. Only VITE_* vars are exposed to the app; never put secrets here.

# Gateway base URL (the API the SPA calls).  LOCAL: http://localhost:80
VITE_API_BASE_URL=http://localhost:80

# Keycloak OIDC — must match PUBLIC_KEYCLOAK_URL in Microservices/.env (same host the browser hits).
VITE_OIDC_AUTHORITY=http://localhost:8089/realms/asm
VITE_OIDC_CLIENT_ID=admin-web

# Optional — redirect/logout default to window.origin (current host). Set only to pin them.
# VITE_OIDC_REDIRECT_URI=
# VITE_OIDC_POST_LOGOUT_URI=
