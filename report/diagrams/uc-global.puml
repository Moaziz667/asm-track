@startuml
!theme vibrant
!pragma layout smetana
left to right direction
skinparam actorStyle awesome
skinparam backgroundColor white
skinparam usecase {
  BackgroundColor #EEF4FF
  BorderColor #0052A3
  ArrowColor #333333
}

actor "Super Admin" as SA
actor "Admin /\nDispatcher" as AD
actor "Chauffeur" as CH

rectangle "ASM Track" {

  usecase "Gérer les entreprises clientes" as SA1
  usecase "Gérer les profils des chauffeurs" as SA2
  usecase "Gérer les comptes administrateurs" as SA3
  usecase "Consulter les statistiques globales" as SA4
  usecase "Configurer les paramètres ERP" as SA5
  usecase "S'authentifier panneau\nsuper-administrateur" as AUTHSA

  usecase "Consulter et replanifier\nles commandes" as AD1
  usecase "S'authentifier sur\nle tableau de bord" as AUTHAD
  usecase "Construire une tournée\npar glisser-déposer" as AD2
  usecase "Calculer l'itinéraire\nvia OSRM" as EX1
  usecase "Assigner une tournée\nà un chauffeur" as AD3
  usecase "Suivre les tournées\nen temps réel" as AD4
  usecase "Visualiser les alertes SLA" as AD5
  usecase "Générer rapport PDF" as AD6

  usecase "S'authentifier sur\nl'application mobile" as AUTHMOB
  usecase "Consulter et exécuter\nsa tournée du jour" as CH1
  usecase "Céder une livraison\nà un autre chauffeur" as EX3a
  usecase "Prendre en charge une livraison\nd'un autre chauffeur" as EX3b
  usecase "Confirmer la livraison avec\ncapture de preuve (POD)" as CH2
  usecase "Confirmer une livraison\npartielle" as EX4
  usecase "Marquer un arrêt\ncomme échoué" as CH3
  usecase "Consulter les notifications" as CH4

  usecase "Envoyer les commandes\nconfirmées vers ASM Track" as ERP1
  usecase "Recevoir les mises à jour\nde statut et de stock" as ERP2
}

rectangle "Système externe" {
  actor "Système ERP\n(Odoo / Dux)" as ERP
}

SA --> SA1
SA --> SA2
SA --> SA3
SA --> SA4
SA --> SA5

AD --> AD1
AD --> AD3
AD --> AD4
AD --> AD5
AD --> AD6

CH --> CH1
CH --> CH2
CH --> CH3
CH --> CH4

ERP --> ERP1
ERP --> ERP2

' <<include>> Super Admin
SA1 ..> AUTHSA : <<include>>
SA2 ..> AUTHSA : <<include>>
SA3 ..> AUTHSA : <<include>>
SA4 ..> AUTHSA : <<include>>
SA5 ..> AUTHSA : <<include>>

' <<include>> Admin / Dispatcher
AD1 ..> AUTHAD : <<include>>
AD3 ..> AUTHAD : <<include>>
AD4 ..> AUTHAD : <<include>>
AD5 ..> AUTHAD : <<include>>
AD6 ..> AUTHAD : <<include>>
EX1 ..> AUTHAD : <<include>>

' <<include>> Chauffeur
CH1 ..> AUTHMOB : <<include>>
CH2 ..> AUTHMOB : <<include>>
CH3 ..> AUTHMOB : <<include>>
CH4 ..> AUTHMOB : <<include>>

' <<extend>>
EX1  ..> AD2 : <<extend>>\n{si calcul demandé}
EX3a ..> CH1 : <<extend>>\n{réaffectation —\ngénère le QR}
EX3b ..> CH1 : <<extend>>\n{réaffectation —\nscanne le QR}
EX4  ..> CH2 : <<extend>>\n{si livraison incomplète}

' forcer positions
AD2 -[hidden]right- EX1
CH1 -[hidden]right- EX3a
CH1 -[hidden]right- EX3b
CH2 -[hidden]right- EX4
@enduml
