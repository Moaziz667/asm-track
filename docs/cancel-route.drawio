    <mxCell id="11" value="Route → CANCELLED&#xa;closedAt = now&#xa;Audit log: CANCEL_ROUTE&#xa;WebSocket → driver: ROUTE_CANCELLED" style="rounded=1;whiteSpace=wrap;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;fontSize=11;" vertex="1" parent="1">
