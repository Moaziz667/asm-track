    <mxCell id="2" value="POST /api/admin/routes/{id}/cancel?reason=..." style="rounded=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=12;" vertex="1" parent="1">
      <mxGeometry x="380" y="40" width="320" height="50" as="geometry"/>
