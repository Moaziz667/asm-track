      <mxGeometry x="520" y="334" width="300" height="70" as="geometry"/>
    </mxCell>

    <!-- PICKED_UP branch -->
    <mxCell id="9" value="Stop → REMOVED_CANCELLED&#xa;Delivery: returnToOrigin = true&#xa;(status unchanged, driver keeps parcel)&#xa;Event: publishDeliveryCancelled&#xa;Odoo? → syncOrderCancellation" style="rounded=1;whiteSpace=wrap;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;" vertex="1" parent="1">
