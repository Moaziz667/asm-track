    <!-- Check route status -->
    <mxCell id="3" value="Route status = VALIDATED or IN_PROGRESS?" style="rhombus;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
