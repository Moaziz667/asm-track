digraph ASMTrack {
    graph [
        rankdir=LR bgcolor=white
        nodesep=0.6 ranksep=1.1
        splines=polyline pad=0.6
        fontname="Helvetica"
        newrank=true
    ]
    node [shape=none fontname="Helvetica" margin="0"]
    edge [fontname="Helvetica" fontsize=0 arrowsize=0.9]

    // ── Client Apps ───────────────────────────────────────────────────────
    subgraph cluster_clients {
        label=<<FONT FACE="Helvetica-Bold" POINT-SIZE="14">Client Apps</FONT>>
        labelloc=t labeljust=c
        style="filled,rounded,dashed"
        fillcolor="#F9FAFB" color="#9CA3AF" penwidth=1.5 margin=20

        admin  [label=<<TABLE BORDER="2" CELLBORDER="0" CELLSPACING="6" CELLPADDING="14" BGCOLOR="#F9FAFB" COLOR="#CBD5E1"><TR><TD ALIGN="CENTER"><IMG SRC="C:\temp\asm_icons/nextjs.png" SCALE="FALSE"/></TD></TR><TR><TD ALIGN="CENTER"><FONT FACE="Helvetica-Bold" POINT-SIZE="11">Admin App</FONT></TD></TR><TR><TD ALIGN="CENTER"><FONT FACE="Helvetica" POINT-SIZE="9" COLOR="#6B7280">Next.js</FONT></TD></TR></TABLE>>]
        driver [label=<<TABLE BORDER="2" CELLBORDER="0" CELLSPACING="6" CELLPADDING="14" BGCOLOR="#EFF9FF" COLOR="#BAE6FD"><TR><TD ALIGN="CENTER"><IMG SRC="C:\temp\asm_icons/flutter.png" SCALE="FALSE"/></TD></TR><TR><TD ALIGN="CENTER"><FONT FACE="Helvetica-Bold" POINT-SIZE="11">Driver App</FONT></TD></TR><TR><TD ALIGN="CENTER"><FONT FACE="Helvetica" POINT-SIZE="9" COLOR="#6B7280">Flutter</FONT></TD></TR></TABLE>>]
        admin -> driver [style=invis]
    }

    // ── API Gateway ───────────────────────────────────────────────────────
    gw [shape=box style="filled,rounded" fillcolor="#DCFCE7" color="#16A34A" penwidth=2.8
        label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="10" CELLPADDING="22">
            <TR><TD ALIGN="CENTER"><IMG SRC="C:\temp\asm_icons/nginx.png" SCALE="FALSE"/></TD></TR>
            <TR><TD ALIGN="CENTER"><FONT FACE="Helvetica-Bold" POINT-SIZE="13" COLOR="#14532D">API Gateway</FONT></TD></TR>
            <TR><TD ALIGN="CENTER"><FONT FACE="Helvetica" POINT-SIZE="10" COLOR="#16A34A">:80</FONT></TD></TR>
        </TABLE>>]

    // ── Core Microservices ────────────────────────────────────────────────
    subgraph cluster_core {
        label=<<FONT FACE="Helvetica-Bold" POINT-SIZE="14" COLOR="#1E40AF">Core Microservices</FONT>>
        labelloc=t labeljust=c
        style="filled,rounded"
        fillcolor="#EFF6FF" color="#3B82F6" penwidth=2.2 margin=25

        auth [shape=box style="filled,rounded" fillcolor="#FFF7ED" color="#F97316" penwidth=3.0
              label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="12">
                <TR>
                  <TD><IMG SRC="C:\temp\asm_icons/jwt.png" SCALE="FALSE"/></TD>
                  <TD ALIGN="LEFT" VALIGN="MIDDLE" CELLPADDING="10">
                    <FONT FACE="Helvetica-Bold" POINT-SIZE="15">auth-server</FONT><BR/>
                    <FONT FACE="Helvetica" POINT-SIZE="10" COLOR="#78716C">:8089</FONT><BR/>
                    <FONT FACE="Helvetica-Oblique" POINT-SIZE="9" COLOR="#EA580C">OAuth2 · RSA JWT Issuer</FONT>
                  </TD>
                </TR>
              </TABLE>>]

        ab  [label=<<TABLE BORDER="2" CELLBORDER="0" CELLSPACING="6" CELLPADDING="14" BGCOLOR="#F0FFF4" COLOR="#86EFAC"><TR><TD ALIGN="CENTER"><IMG SRC="C:\temp\asm_icons/spring.png" SCALE="FALSE"/></TD></TR><TR><TD ALIGN="CENTER"><FONT FACE="Helvetica-Bold" POINT-SIZE="11">AppBackend</FONT></TD></TR><TR><TD ALIGN="CENTER"><FONT FACE="Helvetica" POINT-SIZE="9" COLOR="#6B7280">:8080</FONT></TD></TR></TABLE>>]
        dl  [label=<<TABLE BORDER="2" CELLBORDER="0" CELLSPACING="6" CELLPADDING="14" BGCOLOR="#F0FFF4" COLOR="#86EFAC"><TR><TD ALIGN="CENTER"><IMG SRC="C:\temp\asm_icons/spring.png" SCALE="FALSE"/></TD></TR><TR><TD ALIGN="CENTER"><FONT FACE="Helvetica-Bold" POINT-SIZE="11">DeliveryMicroservice</FONT></TD></TR><TR><TD ALIGN="CENTER"><FONT FACE="Helvetica" POINT-SIZE="9" COLOR="#6B7280">:8082</FONT></TD></TR></TABLE>>]
        ds  [label=<<TABLE BORDER="2" CELLBORDER="0" CELLSPACING="6" CELLPADDING="14" BGCOLOR="#F0FFF4" COLOR="#86EFAC"><TR><TD ALIGN="CENTER"><IMG SRC="C:\temp\asm_icons/spring.png" SCALE="FALSE"/></TD></TR><TR><TD ALIGN="CENTER"><FONT FACE="Helvetica-Bold" POINT-SIZE="11">DriverService</FONT></TD></TR><TR><TD ALIGN="CENTER"><FONT FACE="Helvetica" POINT-SIZE="9" COLOR="#6B7280">:8086</FONT></TD></TR></TABLE>>]
        ea  [label=<<TABLE BORDER="2" CELLBORDER="0" CELLSPACING="6" CELLPADDING="14" BGCOLOR="#F0FFF4" COLOR="#86EFAC"><TR><TD ALIGN="CENTER"><IMG SRC="C:\temp\asm_icons/spring.png" SCALE="FALSE"/></TD></TR><TR><TD ALIGN="CENTER"><FONT FACE="Helvetica-Bold" POINT-SIZE="11">ErpAdapterService</FONT></TD></TR><TR><TD ALIGN="CENTER"><FONT FACE="Helvetica" POINT-SIZE="9" COLOR="#6B7280">:8088</FONT></TD></TR></TABLE>>]

        pga   [label=<<TABLE BORDER="2" CELLBORDER="0" CELLSPACING="5" CELLPADDING="10" BGCOLOR="#F0FDF4" COLOR="#16A34A"><TR><TD ALIGN="CENTER"><IMG SRC="C:\temp\asm_icons/pg.png" SCALE="FALSE"/></TD></TR><TR><TD ALIGN="CENTER"><FONT FACE="Helvetica" POINT-SIZE="9" COLOR="#374151">postgres-app</FONT></TD></TR></TABLE>>]
        pgd   [label=<<TABLE BORDER="2" CELLBORDER="0" CELLSPACING="5" CELLPADDING="10" BGCOLOR="#F0FDF4" COLOR="#16A34A"><TR><TD ALIGN="CENTER"><IMG SRC="C:\temp\asm_icons/pg.png" SCALE="FALSE"/></TD></TR><TR><TD ALIGN="CENTER"><FONT FACE="Helvetica" POINT-SIZE="9" COLOR="#374151">postgres-delivery</FONT></TD></TR></TABLE>>]
        pgr   [label=<<TABLE BORDER="2" CELLBORDER="0" CELLSPACING="5" CELLPADDING="10" BGCOLOR="#F0FDF4" COLOR="#16A34A"><TR><TD ALIGN="CENTER"><IMG SRC="C:\temp\asm_icons/pg.png" SCALE="FALSE"/></TD></TR><TR><TD ALIGN="CENTER"><FONT FACE="Helvetica" POINT-SIZE="9" COLOR="#374151">postgres-driver</FONT></TD></TR></TABLE>>]
        minio [label=<<TABLE BORDER="2" CELLBORDER="0" CELLSPACING="5" CELLPADDING="10" BGCOLOR="#FFF5F5" COLOR="#FCA5A5"><TR><TD ALIGN="CENTER"><IMG SRC="C:\temp\asm_icons/minio.png" SCALE="FALSE"/></TD></TR><TR><TD ALIGN="CENTER"><FONT FACE="Helvetica" POINT-SIZE="9" COLOR="#374151">MinIO</FONT></TD></TR></TABLE>>]

        // vertical ordering inside cluster (no rank conflicts)
        auth -> ab -> dl -> ds -> ea [style=invis weight=10]
        pga  -> pgd -> minio -> pgr  [style=invis weight=10]
    }

    // ── External ─────────────────────────────────────────────────────────
    subgraph cluster_ext {
        label=<<FONT FACE="Helvetica-Bold" POINT-SIZE="14" COLOR="#6D28D9">External / Infrastructure</FONT>>
        labelloc=t labeljust=c
        style="filled,rounded,dashed"
        fillcolor="#FAF5FF" color="#7C3AED" penwidth=1.5 margin=20

        odoo [label=<<TABLE BORDER="2" CELLBORDER="0" CELLSPACING="6" CELLPADDING="14" BGCOLOR="#FAF5FF" COLOR="#C4B5FD"><TR><TD ALIGN="CENTER"><IMG SRC="C:\temp\asm_icons/rack.png" SCALE="FALSE"/></TD></TR><TR><TD ALIGN="CENTER"><FONT FACE="Helvetica-Bold" POINT-SIZE="11">Odoo ERP</FONT></TD></TR><TR><TD ALIGN="CENTER"><FONT FACE="Helvetica" POINT-SIZE="9" COLOR="#6B7280">JSON-RPC 2.0</FONT></TD></TR></TABLE>>]
        fcm  [label=<<TABLE BORDER="2" CELLBORDER="0" CELLSPACING="6" CELLPADDING="14" BGCOLOR="#FFFBEB" COLOR="#FDE68A"><TR><TD ALIGN="CENTER"><IMG SRC="C:\temp\asm_icons/firebase.png" SCALE="FALSE"/></TD></TR><TR><TD ALIGN="CENTER"><FONT FACE="Helvetica-Bold" POINT-SIZE="11">Firebase FCM</FONT></TD></TR><TR><TD ALIGN="CENTER"><FONT FACE="Helvetica" POINT-SIZE="9" COLOR="#6B7280">Push Notifications</FONT></TD></TR></TABLE>>]
        osrm [label=<<TABLE BORDER="2" CELLBORDER="0" CELLSPACING="6" CELLPADDING="14" BGCOLOR="#F0FDF4" COLOR="#BBF7D0"><TR><TD ALIGN="CENTER"><IMG SRC="C:\temp\asm_icons/rack.png" SCALE="FALSE"/></TD></TR><TR><TD ALIGN="CENTER"><FONT FACE="Helvetica-Bold" POINT-SIZE="11">OSRM</FONT></TD></TR><TR><TD ALIGN="CENTER"><FONT FACE="Helvetica" POINT-SIZE="9" COLOR="#6B7280">:5000 · Routing</FONT></TD></TR></TABLE>>]
        odoo -> fcm -> osrm [style=invis]
    }

    // ── HTTP / REST — blue ────────────────────────────────────────────────
    edge [color="#2563EB" penwidth=2.0 arrowhead=normal style=solid]
    admin -> gw
    driver -> gw
    gw -> auth
    gw -> ab
    gw -> dl
    gw -> ds
    gw -> ea [constraint=true]

    // ── DB connections — green dashed ─────────────────────────────────────
    edge [color="#16A34A" penwidth=1.4 arrowhead=open style=dashed]
    auth -> pga [constraint=false]
    auth -> pgr [constraint=false]
    ab   -> pga
    dl   -> pgd
    dl   -> minio
    ds   -> pgr

    // ── OAuth2 — orange dotted ────────────────────────────────────────────
    edge [color="#EA580C" penwidth=1.2 arrowhead=vee style=dotted constraint=false]
    ab -> auth
    dl -> auth
    ds -> auth
    ea -> auth

    // ── Inter-service — cyan dashed ───────────────────────────────────────
    edge [color="#0891B2" penwidth=1.4 arrowhead=normal style=dashed constraint=false]
    dl -> ds
    dl -> ea

    // ── External — purple ─────────────────────────────────────────────────
    edge [color="#7C3AED" penwidth=1.8 arrowhead=normal style=solid]
    ea -> odoo
    dl -> fcm
    dl -> osrm
}
