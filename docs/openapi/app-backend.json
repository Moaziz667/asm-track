{
  "components": {
    "schemas": {
      "AdminUserResponse": {
        "properties": {
          "active": {
            "type": "boolean"
          },
          "createdAt": {
            "format": "date-time",
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "role": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "CreateAdminUserRequest": {
        "properties": {
          "email": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "password": {
            "type": "string"
          },
          "role": {
            "pattern": "ADMIN|DISPATCHER|MANAGER",
            "type": "string"
          }
        },
        "required": [
          "email",
          "name",
          "password",
          "role"
        ],
        "type": "object"
      },
      "InternalAdminUserDTO": {
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "role": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "OnboardRequest": {
        "properties": {
          "adminEmail": {
            "type": "string"
          },
          "adminName": {
            "type": "string"
          },
          "companyName": {
            "type": "string"
          },
          "domain": {
            "type": "string"
          }
        },
        "required": [
          "adminEmail",
          "adminName",
          "companyName"
        ],
        "type": "object"
      },
      "OnboardResult": {
        "properties": {
          "adminUserId": {
            "type": "string"
          },
          "companyId": {
            "type": "string"
          },
          "provisioned": {
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "type": "object"
      },
      "SystemSettingsDto": {
        "properties": {
          "activeErpProvider": {
            "type": "string"
          },
          "connectionStatus": {
            "type": "string"
          },
          "erpConfiguration": {
            "type": "object"
          },
          "lastConnectedAt": {
            "format": "date-time",
            "type": "string"
          },
          "lastError": {
            "type": "string"
          },
          "lastTestUid": {
            "type": "string"
          },
          "lastTestedAt": {
            "format": "date-time",
            "type": "string"
          }
        },
        "type": "object"
      },
      "UpdateAdminUserRequest": {
        "properties": {
          "email": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "role": {
            "type": "string"
          }
        },
        "type": "object"
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "bearerFormat": "JWT",
        "name": "bearerAuth",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "description": "Auth and profile service for ASM Delivery client app",
    "title": "ASM App Backend Service API",
    "version": "1.0.0"
  },
  "openapi": "3.0.1",
  "paths": {
    "/api/auth/backchannel-logout": {
      "post": {
        "description": "Validates the signed logout_token (form-encoded) and revokes the matching session so the admin-web or driver-app client logs out immediately. Always returns 200 to Keycloak, even on a token it can't act on, per the spec.",
        "operationId": "backchannelLogout",
        "parameters": [
          {
            "in": "query",
            "name": "logout_token",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Logout processed (or safely ignored)"
          }
        },
        "summary": "Receive an OIDC back-channel logout",
        "tags": [
          "Auth · Back-Channel Logout"
        ]
      }
    },
    "/api/v1/admin/me": {
      "get": {
        "description": "Returns the caller's own profile, with the display name read live from Keycloak so a self-edit shows immediately without re-login (the token's name claim is a login-time snapshot).",
        "operationId": "me",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminUserResponse"
                }
              }
            },
            "description": "The caller's profile"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminUserResponse"
                }
              }
            },
            "description": "Missing or invalid access token"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "Get my profile",
        "tags": [
          "Admin · Me"
        ]
      }
    },
    "/api/v1/admin/users": {
      "get": {
        "description": "Returns all back-office users of the caller's company.",
        "operationId": "listUsers",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/AdminUserResponse"
                  },
                  "type": "array"
                }
              }
            },
            "description": "List of users"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/AdminUserResponse"
                  },
                  "type": "array"
                }
              }
            },
            "description": "Missing or invalid access token"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/AdminUserResponse"
                  },
                  "type": "array"
                }
              }
            },
            "description": "Caller lacks perm:user:manage"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "List back-office users",
        "tags": [
          "Admin · Users"
        ]
      },
      "post": {
        "description": "Creates a user in the caller's company, provisions it in Keycloak (with the given role and a temporary password), assigns it to the company's Keycloak organization, and records an audit event. Idempotent on email within the tenant.",
        "operationId": "createUser",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateAdminUserRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminUserResponse"
                }
              }
            },
            "description": "User created"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminUserResponse"
                }
              }
            },
            "description": "Validation error (missing/invalid fields)"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminUserResponse"
                }
              }
            },
            "description": "Missing or invalid access token"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminUserResponse"
                }
              }
            },
            "description": "Caller lacks perm:user:manage"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminUserResponse"
                }
              }
            },
            "description": "Email already in use in this company"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "Create a back-office user",
        "tags": [
          "Admin · Users"
        ]
      }
    },
    "/api/v1/admin/users/{id}": {
      "put": {
        "description": "Updates the profile fields and syncs the change to Keycloak (email/role). Renaming the role changes the user's effective permissions on next login.",
        "operationId": "updateUser",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateAdminUserRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminUserResponse"
                }
              }
            },
            "description": "User updated"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminUserResponse"
                }
              }
            },
            "description": "Missing or invalid access token"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminUserResponse"
                }
              }
            },
            "description": "Caller lacks perm:user:manage"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminUserResponse"
                }
              }
            },
            "description": "User not found in this company"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminUserResponse"
                }
              }
            },
            "description": "New email already in use"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "Update a user's name, email or role",
        "tags": [
          "Admin · Users"
        ]
      }
    },
    "/api/v1/admin/users/{id}/logout": {
      "post": {
        "description": "Invalidates the user's Keycloak sessions immediately and broadcasts a session-revoked event so the user's open clients log out without waiting for token expiry.",
        "operationId": "forceLogout",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object"
                }
              }
            },
            "description": "Sessions invalidated"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object"
                }
              }
            },
            "description": "Missing or invalid access token"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object"
                }
              }
            },
            "description": "Caller lacks perm:user:manage"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "Force-logout a user",
        "tags": [
          "Admin · Users"
        ]
      }
    },
    "/api/v1/admin/users/{id}/reset-password-email": {
      "post": {
        "description": "Triggers a Keycloak 'update password' action email to the user. Returns 502 if the Keycloak SMTP server is not configured/reachable.",
        "operationId": "resetPasswordEmail",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object"
                }
              }
            },
            "description": "Reset email triggered"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object"
                }
              }
            },
            "description": "Missing or invalid access token"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object"
                }
              }
            },
            "description": "Caller lacks perm:user:manage"
          },
          "502": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object"
                }
              }
            },
            "description": "Keycloak SMTP not configured/reachable"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "Send a password-reset email",
        "tags": [
          "Admin · Users"
        ]
      }
    },
    "/api/v1/admin/users/{id}/status": {
      "patch": {
        "description": "Enables or disables the account. Body: {\"active\": true|false}. A disabled user keeps its data but can no longer authenticate. Change propagates to Keycloak.",
        "operationId": "setStatus",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "additionalProperties": {
                  "type": "boolean"
                },
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminUserResponse"
                }
              }
            },
            "description": "Status updated"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminUserResponse"
                }
              }
            },
            "description": "Missing 'active' field"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminUserResponse"
                }
              }
            },
            "description": "Missing or invalid access token"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminUserResponse"
                }
              }
            },
            "description": "Caller lacks perm:user:manage"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminUserResponse"
                }
              }
            },
            "description": "User not found in this company"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "Activate or deactivate a user",
        "tags": [
          "Admin · Users"
        ]
      }
    },
    "/api/v1/settings/erp": {
      "get": {
        "description": "Returns the company's Odoo connection settings. Secrets (password/API key) are masked in the response — never returned in clear.",
        "operationId": "getErpSettings",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SystemSettingsDto"
                }
              }
            },
            "description": "ERP settings (secrets masked)"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SystemSettingsDto"
                }
              }
            },
            "description": "Missing or invalid access token"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SystemSettingsDto"
                }
              }
            },
            "description": "Caller lacks the required permission"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "Get ERP settings",
        "tags": [
          "Settings · ERP"
        ]
      },
      "put": {
        "description": "Saves the company's Odoo URL and credentials (encrypted at rest). The URL host must be in the server's ERP allow-list. Omitted secret fields keep their stored value.",
        "operationId": "updateErpSettings",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SystemSettingsDto"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Settings saved"
          },
          "400": {
            "description": "Invalid URL or host not allow-listed"
          },
          "401": {
            "description": "Missing or invalid access token"
          },
          "403": {
            "description": "Caller lacks the required permission"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "Update ERP settings",
        "tags": [
          "Settings · ERP"
        ]
      }
    },
    "/api/v1/settings/erp/conformance": {
      "get": {
        "description": "Runs the read-only conformance probe against the company's configured ERP and returns a GO/DEGRADED/NO_GO report with the detected version and per-capability results. 204 when no ERP is configured.",
        "operationId": "getErpConformance",
        "parameters": [
          {
            "in": "query",
            "name": "forceRefresh",
            "required": false,
            "schema": {
              "default": false,
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            },
            "description": "Conformance report"
          },
          "204": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            },
            "description": "No ERP configured"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            },
            "description": "Missing or invalid access token"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            },
            "description": "Caller lacks the required permission"
          },
          "502": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            },
            "description": "ERP adapter unreachable"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "Certify the ERP instance (drytest)",
        "tags": [
          "Settings · ERP"
        ]
      }
    },
