    <mxCell id="2" value="POST /api/admin/deliveries/{id}/cancel&#xa;body: { reason }" style="rounded=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=12;" vertex="1" parent="1">
