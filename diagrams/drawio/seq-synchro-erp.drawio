        <mxCell id="altOutG2" parent="1" vertex="1" style="text;html=1;align=left;fontSize=11;fontStyle=2;fontColor=#333333;" value="[ nouveau txId ]"><mxGeometry height="18" width="260" x="610" y="882" as="geometry" /></mxCell>
        <mxCell id="m13" parent="1" edge="1" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;edgeStyle=none;fontSize=12;fontColor=#263238;labelBackgroundColor=#FFFFFF;strokeColor=#37474F;" value="valide le transfert (JSON-RPC / REST)"><mxGeometry relative="1" as="geometry"><mxPoint x="1420" y="918" as="sourcePoint" /><mxPoint x="1680" y="918" as="targetPoint" /></mxGeometry></mxCell>

