        <mxCell id="altIn" parent="1" vertex="1" style="shape=umlFrame;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#999999;width=60;height=24;fontSize=12;fontStyle=1;" value="alt"><mxGeometry height="380" width="1230" x="580" y="945" as="geometry" /></mxCell>
        <mxCell id="altInG1" parent="1" vertex="1" style="text;html=1;align=left;fontSize=11;fontStyle=2;fontColor=#333333;" value="[ transfert accepté ]"><mxGeometry height="18" width="240" x="648" y="949" as="geometry" /></mxCell>
        <mxCell id="m14" parent="1" edge="1" style="html=1;verticalAlign=bottom;endArrow=open;endSize=12;rounded=0;edgeStyle=none;dashed=1;dashPattern=6 4;fontSize=12;fontColor=#263238;labelBackgroundColor=#FFFFFF;strokeColor=#37474F;" value="transfert validé"><mxGeometry relative="1" as="geometry"><mxPoint x="1680" y="985" as="sourcePoint" /><mxPoint x="1420" y="985" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m15" parent="1" edge="1" style="html=1;verticalAlign=bottom;endArrow=open;endSize=14;rounded=0;edgeStyle=none;fontSize=12;fontColor=#E65100;labelBackgroundColor=#FFFFFF;strokeColor=#E65100;" value="publie  erp.sync.result (succès)"><mxGeometry relative="1" as="geometry"><mxPoint x="1420" y="1023" as="sourcePoint" /><mxPoint x="1160" y="1023" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m16" parent="1" edge="1" style="html=1;verticalAlign=bottom;endArrow=open;endSize=14;rounded=0;edgeStyle=none;fontSize=12;fontColor=#E65100;labelBackgroundColor=#FFFFFF;strokeColor=#E65100;" value="erp.sync.result"><mxGeometry relative="1" as="geometry"><mxPoint x="1160" y="1060" as="sourcePoint" /><mxPoint x="640" y="1060" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m17" parent="1" edge="1" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;edgeStyle=none;fontSize=12;fontColor=#263238;labelBackgroundColor=#FFFFFF;strokeColor=#37474F;" value="order = SYNCED"><mxGeometry relative="1" as="geometry"><mxPoint x="640" y="1098" as="sourcePoint" /><mxPoint x="900" y="1098" as="targetPoint" /></mxGeometry></mxCell>

