        <mxCell id="m12" parent="1" edge="1" style="html=1;verticalAlign=bottom;endArrow=open;endSize=14;rounded=0;edgeStyle=none;fontSize=12;fontColor=#E65100;labelBackgroundColor=#FFFFFF;strokeColor=#E65100;" value="erp.sync.result"><mxGeometry relative="1" as="geometry"><mxPoint x="1160" y="848" as="sourcePoint" /><mxPoint x="640" y="848" as="targetPoint" /></mxGeometry></mxCell>

