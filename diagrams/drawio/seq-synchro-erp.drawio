        <mxCell id="m9" parent="1" edge="1" style="html=1;verticalAlign=bottom;endArrow=open;endSize=14;rounded=0;edgeStyle=none;fontSize=12;fontColor=#E65100;labelBackgroundColor=#FFFFFF;strokeColor=#E65100;" value="erp.sync.command"><mxGeometry relative="1" as="geometry"><mxPoint x="1160" y="625" as="sourcePoint" /><mxPoint x="1420" y="625" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m10" parent="1" edge="1" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;fontSize=12;fontColor=#263238;labelBackgroundColor=#FFFFFF;strokeColor=#37474F;" value="résout tenant + provider · vérifie l&#39;idempotence (txId)"><mxGeometry relative="1" as="geometry"><mxPoint x="1420" y="655" as="sourcePoint" /><mxPoint x="1420" y="679" as="targetPoint" /><Array as="points"><mxPoint x="1590" y="655" /><mxPoint x="1590" y="679" /></Array></mxGeometry></mxCell>
        <mxCell id="n2" parent="1" vertex="1" style="shape=note;whiteSpace=wrap;html=1;size=12;fillColor=#FFFDF5;strokeColor=#37474F;fontSize=10;align=left;spacingLeft=6;spacingRight=6;verticalAlign=middle;" value="Idempotence sur txId : un même txId n&#39;appelle l&#39;ERP qu&#39;une fois → pas de double mise à jour du stock."><mxGeometry height="52" width="220" x="1190" y="700" as="geometry" /></mxCell>

