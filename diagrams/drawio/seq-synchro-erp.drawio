        <mxCell id="altOutG1" parent="1" vertex="1" style="text;html=1;align=left;fontSize=11;fontStyle=2;fontColor=#333333;" value="[ txId déjà traité (rejeu) ]"><mxGeometry height="18" width="260" x="610" y="774" as="geometry" /></mxCell>
