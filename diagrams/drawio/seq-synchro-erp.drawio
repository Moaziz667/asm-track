        <!-- ==================== PHASE 1 ==================== -->
        <mxCell id="p1" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontStyle=1;fontColor=#263238;align=left;spacingLeft=10;" value="Phase 1 — Écriture transactionnelle (synchrone)"><mxGeometry height="26" width="1740" x="60" y="185" as="geometry" /></mxCell>
        <mxCell id="m1" parent="1" edge="1" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;edgeStyle=none;fontSize=12;fontColor=#263238;labelBackgroundColor=#FFFFFF;strokeColor=#37474F;" value="valide la livraison (POD)"><mxGeometry relative="1" as="geometry"><mxPoint x="130" y="240" as="sourcePoint" /><mxPoint x="380" y="240" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m2" parent="1" edge="1" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;edgeStyle=none;fontSize=12;fontColor=#263238;labelBackgroundColor=#FFFFFF;strokeColor=#37474F;" value="envoie la preuve de livraison"><mxGeometry relative="1" as="geometry"><mxPoint x="380" y="270" as="sourcePoint" /><mxPoint x="640" y="270" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m3" parent="1" edge="1" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;edgeStyle=none;fontSize=12;fontColor=#263238;labelBackgroundColor=#FFFFFF;strokeColor=#37474F;" value="1 transaction : DELIVERED + outbox(PENDING) + PENDING_SYNC"><mxGeometry relative="1" as="geometry"><mxPoint x="640" y="310" as="sourcePoint" /><mxPoint x="900" y="310" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m4" parent="1" edge="1" style="html=1;verticalAlign=bottom;endArrow=open;endSize=12;rounded=0;edgeStyle=none;dashed=1;dashPattern=6 4;fontSize=12;fontColor=#263238;labelBackgroundColor=#FFFFFF;strokeColor=#37474F;" value="200 OK"><mxGeometry relative="1" as="geometry"><mxPoint x="640" y="350" as="sourcePoint" /><mxPoint x="380" y="350" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m5" parent="1" edge="1" style="html=1;verticalAlign=bottom;endArrow=open;endSize=12;rounded=0;edgeStyle=none;dashed=1;dashPattern=6 4;fontSize=12;fontColor=#263238;labelBackgroundColor=#FFFFFF;strokeColor=#37474F;" value="livraison confirmée"><mxGeometry relative="1" as="geometry"><mxPoint x="380" y="390" as="sourcePoint" /><mxPoint x="130" y="390" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="n1" parent="1" vertex="1" style="shape=note;whiteSpace=wrap;html=1;size=12;fillColor=#FFFDF5;strokeColor=#37474F;fontSize=10;align=left;spacingLeft=6;spacingRight=6;verticalAlign=middle;" value="Une seule transaction : la livraison et l&#39;outbox sont commités ensemble → aucun événement perdu."><mxGeometry height="52" width="240" x="960" y="308" as="geometry" /></mxCell>

        <!-- ==================== PHASE 2 ==================== -->
        <mxCell id="p2" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontStyle=1;fontColor=#263238;align=left;spacingLeft=10;" value="Phase 2 — Drainage &amp; envoi (asynchrone) — le livreur n&#39;attend jamais l&#39;ERP"><mxGeometry height="26" width="1740" x="60" y="430" as="geometry" /></mxCell>
        <mxCell id="m6" parent="1" edge="1" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;fontSize=12;fontColor=#263238;labelBackgroundColor=#FFFFFF;strokeColor=#37474F;" value="OutboxProcessor (~20 s) : lit l&#39;outbox PENDING (SKIP LOCKED)"><mxGeometry relative="1" as="geometry"><mxPoint x="640" y="470" as="sourcePoint" /><mxPoint x="640" y="494" as="targetPoint" /><Array as="points"><mxPoint x="810" y="470" /><mxPoint x="810" y="494" /></Array></mxGeometry></mxCell>
        <mxCell id="m7" parent="1" edge="1" style="html=1;verticalAlign=bottom;endArrow=open;endSize=14;rounded=0;edgeStyle=none;fontSize=12;fontColor=#E65100;labelBackgroundColor=#FFFFFF;strokeColor=#E65100;" value="publie  erp.sync.command"><mxGeometry relative="1" as="geometry"><mxPoint x="640" y="520" as="sourcePoint" /><mxPoint x="1160" y="520" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m8" parent="1" edge="1" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;edgeStyle=none;fontSize=12;fontColor=#263238;labelBackgroundColor=#FFFFFF;strokeColor=#37474F;" value="outbox = PROCESSED"><mxGeometry relative="1" as="geometry"><mxPoint x="640" y="556" as="sourcePoint" /><mxPoint x="900" y="556" as="targetPoint" /></mxGeometry></mxCell>

        <!-- ==================== PHASE 3 ==================== -->
