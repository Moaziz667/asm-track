        <mxCell id="ERPi" parent="1" vertex="1" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" value=""><mxGeometry height="58" width="30" x="1665" y="88" as="geometry" /></mxCell>

