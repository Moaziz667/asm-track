        <mxCell id="m18" parent="1" edge="1" style="html=1;verticalAlign=bottom;endArrow=open;endSize=12;rounded=0;edgeStyle=none;dashed=1;dashPattern=6 4;fontSize=12;fontColor=#C62828;labelBackgroundColor=#FFFFFF;strokeColor=#C62828;" value="erreur"><mxGeometry relative="1" as="geometry"><mxPoint x="1680" y="1172" as="sourcePoint" /><mxPoint x="1420" y="1172" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m19" parent="1" edge="1" style="html=1;verticalAlign=bottom;endArrow=open;endSize=14;rounded=0;edgeStyle=none;fontSize=12;fontColor=#E65100;labelBackgroundColor=#FFFFFF;strokeColor=#E65100;" value="publie  erp.sync.result (échec)"><mxGeometry relative="1" as="geometry"><mxPoint x="1420" y="1210" as="sourcePoint" /><mxPoint x="1160" y="1210" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m20" parent="1" edge="1" style="html=1;verticalAlign=bottom;endArrow=open;endSize=14;rounded=0;edgeStyle=none;fontSize=12;fontColor=#E65100;labelBackgroundColor=#FFFFFF;strokeColor=#E65100;" value="erp.sync.result"><mxGeometry relative="1" as="geometry"><mxPoint x="1160" y="1247" as="sourcePoint" /><mxPoint x="640" y="1247" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m21" parent="1" edge="1" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;edgeStyle=none;fontSize=12;fontColor=#263238;labelBackgroundColor=#FFFFFF;strokeColor=#37474F;" value="order reste PENDING_SYNC — rejeu (backoff / file morte)"><mxGeometry relative="1" as="geometry"><mxPoint x="640" y="1285" as="sourcePoint" /><mxPoint x="900" y="1285" as="targetPoint" /></mxGeometry></mxCell>

