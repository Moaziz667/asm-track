        <mxCell id="vtitle" parent="1" style="text;html=1;align=center;fontSize=13;fontStyle=1" value="&lt;span&gt;À chaque instant, la phase en cours rend l&#39;un de ces trois verdicts&lt;/span&gt;" vertex="1">
