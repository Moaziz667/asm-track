        </mxCell>
        <mxCell id="s5-m25" edge="1" parent="1" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;edgeStyle=none;fontSize=12;fontColor=#263238;labelBackgroundColor=#FFFFFF;strokeColor=#37474F;dashed=1;dashPattern=6 4;" value="Notifie l'opérateur — l'échec devient visible, il n'est jamais silencieux">
          <mxGeometry relative="1" as="geometry"><mxPoint x="960" y="1546.0" as="sourcePoint" /><mxPoint x="2640" y="1546.0" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="s5-n2" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFFDF5;strokeColor=#37474F;fontSize=11;align=left;spacingLeft=6;spacingRight=6;verticalAlign=middle;" value="Avant chaque tentative, l'adaptateur relit l'état dans l'ERP. Un transfert déjà validé n'est jamais revalidé : le stock ne sort pas deux fois, même si une réponse s'est perdue." vertex="1">
