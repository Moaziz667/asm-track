          <mxGeometry relative="1" as="geometry"><mxPoint x="680" y="1764.0" as="sourcePoint" /><mxPoint x="2640" y="1764.0" as="targetPoint" /></mxGeometry>
        </mxCell>

        <mxCell id="s5-legend" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFDF5;strokeColor=#37474F;fontSize=12;align=left;spacingLeft=12;verticalAlign=top;spacingTop=8;" value="Trois filets, trois délais — l'intention est écrite en base avant tout envoi, aucune panne en aval ne peut l'effacer.&#10;&#10;• ERP injoignable → 5 essais, ≈ 30 s, puis file de rebut et alerte à l'opérateur.&#10;• RabbitMQ injoignable → 15 essais, ≈ 22 h, l'événement reste en base.&#10;• Service Livraison interrompu → un événement resté « en cours » est remis en attente après 5 minutes." vertex="1">
          <mxGeometry height="120" width="2700" x="60" y="1916.0" as="geometry" />
        </mxCell>
