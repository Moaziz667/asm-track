        </mxCell>

        <!-- ==================== gestion des comptes ==================== -->
        <mxCell id="TG1" parent="1" vertex="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#616161;" value="Gestion des comptes">
          <mxGeometry height="20" width="220" x="400" y="98" as="geometry" />
        </mxCell>
        <mxCell id="UC_CREATE" parent="1" vertex="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#EEF3F8;strokeColor=#1F6CA0;fontSize=13;" value="Créer un compte utilisateur">
          <mxGeometry height="64" width="260" x="400" y="120" as="geometry" />
        </mxCell>
        <mxCell id="UC_EDIT" parent="1" vertex="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#EEF3F8;strokeColor=#1F6CA0;fontSize=13;" value="Modifier un compte">
          <mxGeometry height="64" width="260" x="400" y="210" as="geometry" />
        </mxCell>
        <mxCell id="UC_ROLE" parent="1" vertex="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#EEF3F8;strokeColor=#1F6CA0;fontSize=13;" value="Attribuer un rôle">
          <mxGeometry height="64" width="260" x="400" y="300" as="geometry" />
        </mxCell>
        <mxCell id="UC_ENABLE" parent="1" vertex="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#EEF3F8;strokeColor=#1F6CA0;fontSize=13;" value="Activer ou désactiver un compte">
          <mxGeometry height="64" width="260" x="400" y="390" as="geometry" />
        </mxCell>
        <mxCell id="UC_RESET" parent="1" vertex="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#EEF3F8;strokeColor=#1F6CA0;fontSize=13;" value="Envoyer un lien de réinitialisation du mot de passe">
          <mxGeometry height="64" width="260" x="400" y="480" as="geometry" />
        </mxCell>
