        </mxCell>

        <!-- ==================== session ==================== -->
        <mxCell id="TG2" parent="1" vertex="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#616161;" value="Session">
