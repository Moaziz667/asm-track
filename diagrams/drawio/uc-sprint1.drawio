<mxfile host="app.diagrams.net">
  <diagram id="uc-sprint1" name="Cas d'utilisation — sprint 1">
    <mxGraphModel dx="800" dy="600" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ==================== frontiere ==================== -->
        <mxCell id="SYS" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;fontSize=17;fontStyle=1;fillColor=none;strokeColor=#37474F;spacingTop=10;" value="ASM Track — sprint 1">
          <mxGeometry height="860" width="700" x="340" y="60" as="geometry" />
        </mxCell>

        <!-- ==================== acteurs ==================== -->
        <mxCell id="ADMIN" parent="1" vertex="1" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=14;" value="Administrateur">
          <mxGeometry height="90" width="50" x="140" y="300" as="geometry" />
        </mxCell>
        <mxCell id="DISP" parent="1" vertex="1" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=14;" value="Dispatcheur">
