<mxCell id="ROUTER" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;fillColor=#FFFFFF;strokeColor=#37474F;fontSize=12;" value="&lt;p style=&#39;margin:4px 0 0 0;text-align:center;font-size:11px;font-style:italic&#39;&gt;«service»&lt;/p&gt;&lt;p style=&#39;margin:0 0 5px 0;text-align:center;font-weight:bold;font-size:13px&#39;&gt;ErpProviderRouter&lt;/p&gt;&lt;hr style=&#39;margin:0&#39;/&gt;&lt;div style=&#39;margin:5px 0&#39;&gt;&amp;nbsp;&lt;/div&gt;&lt;hr style=&#39;margin:0&#39;/&gt;&lt;div style=&#39;margin:5px 0&#39;&gt;+ forSync() : ErpSyncPort&lt;br&gt;+ forLookup() : ErpLookupPort&lt;br&gt;+ forOrder() : ErpOrderPort&lt;br&gt;+ forChange() : ErpChangePort&lt;/div&gt;"><mxGeometry x="40" y="250" width="300" height="150" as="geometry"/></mxCell>
