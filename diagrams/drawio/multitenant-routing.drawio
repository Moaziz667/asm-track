<mxfile host="app.diagrams.net">
  <diagram id="multitenant-routing" name="Routage multi-tenant par schéma">
    <mxGraphModel dx="800" dy="600" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ================= bandes ================= -->
        <mxCell id="C1" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#BDBDBD;dashed=1;verticalAlign=top;fontSize=15;fontStyle=1;spacingTop=8;" value="Client">
          <mxGeometry height="700" width="300" x="40" y="70" as="geometry" />
        </mxCell>
        <mxCell id="C2" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#BDBDBD;dashed=1;verticalAlign=top;fontSize=15;fontStyle=1;spacingTop=8;" value="Passerelle API">
          <mxGeometry height="700" width="360" x="380" y="70" as="geometry" />
        </mxCell>
        <mxCell id="C3" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#BDBDBD;dashed=1;verticalAlign=top;fontSize=15;fontStyle=1;spacingTop=8;" value="Service métier">
          <mxGeometry height="700" width="580" x="780" y="70" as="geometry" />
        </mxCell>

        <!-- ================= systeme externe ================= -->
        <mxCell id="KC" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#37474F;fontSize=12;" value="&lt;i&gt;«Système externe»&lt;/i&gt;&lt;br&gt;Serveur d'identité">
          <mxGeometry height="60" width="300" x="410" y="105" as="geometry" />
        </mxCell>

        <!-- ================= etapes ================= -->
        <mxCell id="S1" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EEF3F8;strokeColor=#1F6CA0;fontSize=13;" value="&lt;b&gt;1&lt;/b&gt;&amp;nbsp; Requête munie du jeton d'accès obtenu à la connexion">
          <mxGeometry height="90" width="240" x="70" y="300" as="geometry" />
        </mxCell>

        <mxCell id="S2" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EEF3F8;strokeColor=#1F6CA0;fontSize=13;" value="&lt;b&gt;2&lt;/b&gt;&amp;nbsp; Les en-têtes d'identité fournis par le client sont effacés">
          <mxGeometry height="70" width="300" x="410" y="205" as="geometry" />
        </mxCell>
        <mxCell id="S3" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EEF3F8;strokeColor=#1F6CA0;fontSize=13;" value="&lt;b&gt;3&lt;/b&gt;&amp;nbsp; Le jeton est vérifié">
          <mxGeometry height="60" width="300" x="410" y="310" as="geometry" />
        </mxCell>
        <mxCell id="S4" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EEF3F8;strokeColor=#1F6CA0;fontSize=13;" value="&lt;b&gt;4&lt;/b&gt;&amp;nbsp; L'entreprise à laquelle appartient l'utilisateur est lue dans le jeton">
          <mxGeometry height="80" width="300" x="410" y="405" as="geometry" />
        </mxCell>
        <mxCell id="S5" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EEF3F8;strokeColor=#1F6CA0;fontSize=13;" value="&lt;b&gt;5&lt;/b&gt;&amp;nbsp; Elle est transmise au service dans l'en-tête &lt;i&gt;X-Company-Id&lt;/i&gt;">
          <mxGeometry height="70" width="300" x="410" y="520" as="geometry" />
        </mxCell>

        <mxCell id="S6" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EEF3F8;strokeColor=#1F6CA0;fontSize=13;" value="&lt;b&gt;6&lt;/b&gt;&amp;nbsp; L'entreprise est placée dans le contexte de la requête">
          <mxGeometry height="70" width="480" x="820" y="205" as="geometry" />
        </mxCell>
        <mxCell id="S7" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EEF3F8;strokeColor=#1F6CA0;fontSize=13;" value="&lt;b&gt;7&lt;/b&gt;&amp;nbsp; Le nom du schéma en est déduit :&amp;nbsp;&lt;b&gt;company_&amp;lt;32 caractères hexadécimaux&amp;gt;&lt;/b&gt;">
          <mxGeometry height="80" width="480" x="820" y="310" as="geometry" />
        </mxCell>
        <mxCell id="S8" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EEF3F8;strokeColor=#1F6CA0;fontSize=13;" value="&lt;b&gt;8&lt;/b&gt;&amp;nbsp; La connexion bascule sur ce schéma le temps de la transaction, puis retrouve son état initial">
          <mxGeometry height="80" width="480" x="820" y="425" as="geometry" />
        </mxCell>

        <!-- ================= refus ================= -->
        <mxCell id="REFUS" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FDECEA;strokeColor=#B71C1C;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" value="&lt;b&gt;Refus explicites&lt;/b&gt;&lt;br&gt;• aucune entreprise dans le jeton&lt;br&gt;• utilisateur rattaché à plusieurs entreprises&lt;br&gt;• en-tête absent côté service&lt;br&gt;&lt;br&gt;&lt;i&gt;En cas de doute la requête est rejetée : jamais de repli sur une entreprise par défaut.&lt;/i&gt;">
          <mxGeometry height="140" width="300" x="410" y="620" as="geometry" />
        </mxCell>

        <!-- ================= propagation asynchrone ================= -->
        <mxCell id="ASYNC" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F6CA0;dashed=1;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" value="&lt;b&gt;Traitements asynchrones&lt;/b&gt;&lt;br&gt;L'entreprise voyage avec le message dans la file : le consommateur retrouve le même schéma, sans requête HTTP pour le lui dire.">
          <mxGeometry height="110" width="480" x="820" y="555" as="geometry" />
        </mxCell>

        <!-- ================= base ================= -->
        <mxCell id="PG" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#37474F;verticalAlign=top;fontSize=14;fontStyle=1;spacingTop=8;" value="PostgreSQL — une seule base, un schéma par entreprise cliente">
          <mxGeometry height="150" width="580" x="780" y="820" as="geometry" />
        </mxCell>
        <mxCell id="SC1" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EEF3F8;strokeColor=#1F6CA0;fontSize=12;" value="company_54ed…">
          <mxGeometry height="60" width="160" x="810" y="890" as="geometry" />
        </mxCell>
        <mxCell id="SC2" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EEF3F8;strokeColor=#1F6CA0;fontSize=12;" value="company_a91b…">
          <mxGeometry height="60" width="160" x="990" y="890" as="geometry" />
        </mxCell>
        <mxCell id="SC3" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9E9E9E;fontSize=12;fontColor=#757575;" value="public&lt;br&gt;&lt;i&gt;(vide)&lt;/i&gt;">
          <mxGeometry height="60" width="160" x="1170" y="890" as="geometry" />
        </mxCell>

        <!-- ================= liens ================= -->
        <mxCell id="e1" parent="1" edge="1" source="S1" target="S2" style="html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="360" y="345" /><mxPoint x="360" y="240" /></Array></mxGeometry>
        </mxCell>
        <mxCell id="e2" parent="1" edge="1" source="S2" target="S3" style="html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" parent="1" edge="1" source="S3" target="KC" value="vérifie la signature" style="html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;dashed=1;endArrow=open;endFill=0;fontSize=11;labelBackgroundColor=#FAFAFA;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="392" y="340" /><mxPoint x="392" y="135" /></Array></mxGeometry>
        </mxCell>
        <mxCell id="e4" parent="1" edge="1" source="S3" target="S4" style="html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" parent="1" edge="1" source="S4" target="S5" style="html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e6" parent="1" edge="1" source="S5" target="S6" style="html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="760" y="555" /><mxPoint x="760" y="240" /></Array></mxGeometry>
        </mxCell>
        <mxCell id="e7" parent="1" edge="1" source="S6" target="S7" style="html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e8" parent="1" edge="1" source="S7" target="S8" style="html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e9" parent="1" edge="1" source="S8" target="SC1" style="html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;endArrow=block;endFill=1;exitX=0.15;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="890" y="790" /></Array></mxGeometry>
        </mxCell>
        <mxCell id="e10" parent="1" edge="1" source="ASYNC" target="SC2" style="html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;dashed=1;endArrow=block;endFill=1;exitX=0.35;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="988" y="790" /></Array></mxGeometry>
        </mxCell>
        <mxCell id="e11" parent="1" edge="1" source="S4" target="REFUS" style="html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;dashed=1;endArrow=open;endFill=0;strokeColor=#B71C1C;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.25;entryDx=0;entryDy=0;">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="728" y="445" /><mxPoint x="728" y="655" /></Array></mxGeometry>
        </mxCell>
        <mxCell id="e12" parent="1" edge="1" source="S6" target="REFUS" style="html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;dashed=1;endArrow=open;endFill=0;strokeColor=#B71C1C;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.6;entryDx=0;entryDy=0;">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="770" y="240" /><mxPoint x="770" y="704" /></Array></mxGeometry>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
