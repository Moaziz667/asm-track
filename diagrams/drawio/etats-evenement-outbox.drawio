<mxfile host="app.diagrams.net">
  <diagram id="etats-outbox" name="États — Événement outbox">
    <mxGraphModel dx="1200" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1120" pageHeight="680" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="TTL" parent="1" vertex="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontStyle=1;fontColor=#263238;" value="Diagramme d&#39;états — Événement de la file de sortie (outbox)">
          <mxGeometry x="40" y="20" width="800" height="30" as="geometry" />
        </mxCell>

        <!-- ==================== pseudo-état initial ==================== -->
        <mxCell id="INIT" parent="1" vertex="1" style="ellipse;fillColor=#000000;strokeColor=#000000;html=1;" value="">
          <mxGeometry x="330" y="72" width="20" height="20" as="geometry" />
        </mxCell>

        <!-- ==================== états ==================== -->
        <mxCell id="PENDING" parent="1" vertex="1" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#37474F;fontSize=13;verticalAlign=middle;align=center;" value="&lt;b&gt;PENDING&lt;/b&gt;&lt;br&gt;&lt;font style=&#39;font-size:10px;color:#607D8B&#39;&gt;en attente de drainage&lt;/font&gt;">
          <mxGeometry x="260" y="132" width="170" height="54" as="geometry" />
        </mxCell>
        <mxCell id="PROCESSING" parent="1" vertex="1" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#37474F;fontSize=13;verticalAlign=middle;align=center;" value="&lt;b&gt;PROCESSING&lt;/b&gt;&lt;br&gt;&lt;font style=&#39;font-size:10px;color:#607D8B&#39;&gt;réclamé par l&#39;ordonnanceur&lt;/font&gt;">
          <mxGeometry x="260" y="304" width="170" height="54" as="geometry" />
        </mxCell>
        <mxCell id="PROCESSED" parent="1" vertex="1" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;fontSize=13;verticalAlign=middle;align=center;" value="&lt;b&gt;PROCESSED&lt;/b&gt;&lt;br&gt;&lt;font style=&#39;font-size:10px;color:#607D8B&#39;&gt;publié vers RabbitMQ&lt;/font&gt;">
          <mxGeometry x="580" y="278" width="180" height="54" as="geometry" />
        </mxCell>
        <mxCell id="FAILED" parent="1" vertex="1" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#FFEBEE;strokeColor=#C62828;fontSize=13;verticalAlign=middle;align=center;" value="&lt;b&gt;FAILED&lt;/b&gt;&lt;br&gt;&lt;font style=&#39;font-size:10px;color:#607D8B&#39;&gt;abandon après 15 tentatives&lt;/font&gt;">
          <mxGeometry x="580" y="420" width="180" height="54" as="geometry" />
        </mxCell>

        <!-- ==================== états finaux ==================== -->
        <mxCell id="FIN1" parent="1" vertex="1" style="ellipse;shape=endState;fillColor=#000000;strokeColor=#000000;html=1;" value="">
          <mxGeometry x="850" y="293" width="24" height="24" as="geometry" />
        </mxCell>
        <mxCell id="FIN2" parent="1" vertex="1" style="ellipse;shape=endState;fillColor=#000000;strokeColor=#000000;html=1;" value="">
          <mxGeometry x="850" y="435" width="24" height="24" as="geometry" />
        </mxCell>

        <!-- ==================== transitions ==================== -->
        <!-- 1 : initial -> PENDING -->
        <mxCell id="T1" parent="1" edge="1" source="INIT" target="PENDING" style="html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;endArrow=open;endSize=10;strokeColor=#37474F;fontSize=11;fontColor=#263238;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" value="&lt;b&gt;créé avec le fait métier&lt;/b&gt;&lt;br&gt;&lt;font style=&#39;font-size:10px&#39;&gt;(même transaction)&lt;/font&gt;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 2 : PENDING -> PROCESSING -->
        <mxCell id="T2" parent="1" edge="1" source="PENDING" target="PROCESSING" style="html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;endArrow=open;endSize=10;strokeColor=#37474F;fontSize=11;fontColor=#263238;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" value="&lt;b&gt;pris par l&#39;ordonnanceur (20 s)&lt;/b&gt;&lt;br&gt;&lt;i&gt;[délai d&#39;attente écoulé]&lt;/i&gt;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 3 : PROCESSING -> PROCESSED -->
        <mxCell id="T3" parent="1" edge="1" source="PROCESSING" target="PROCESSED" style="html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;endArrow=open;endSize=10;strokeColor=#2E7D32;fontSize=11;fontColor=#1B5E20;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.4;entryX=0;entryY=0.5;" value="&lt;b&gt;publié vers RabbitMQ&lt;/b&gt;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="T3f" parent="1" edge="1" source="PROCESSED" target="FIN1" style="html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;endArrow=open;endSize=10;strokeColor=#2E7D32;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- pseudo-état choix (branchement post-échec) -->
        <mxCell id="CHOICE" parent="1" vertex="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#37474F;fontSize=10;" value="">
          <mxGeometry x="312" y="416" width="66" height="66" as="geometry" />
        </mxCell>

        <!-- échec : PROCESSING -> choix -->
        <mxCell id="TE" parent="1" edge="1" source="PROCESSING" target="CHOICE" style="html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;endArrow=open;endSize=10;strokeColor=#C62828;fontSize=11;fontColor=#B71C1C;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" value="&lt;b&gt;échec&lt;/b&gt;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 5 : choix -[>=15]-> FAILED -->
        <mxCell id="T5" parent="1" edge="1" source="CHOICE" target="FAILED" style="html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;endArrow=open;endSize=10;strokeColor=#C62828;fontSize=11;fontColor=#B71C1C;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" value="&lt;i&gt;[15 tentatives dépassées]&lt;/i&gt;&lt;br&gt;/ mis en file morte">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="T5f" parent="1" edge="1" source="FAILED" target="FIN2" style="html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;endArrow=open;endSize=10;strokeColor=#C62828;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 4 : choix -[<15]-> PENDING (réessai, boucle gauche) -->
        <mxCell id="T4" parent="1" edge="1" source="CHOICE" target="PENDING" style="html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;endArrow=open;endSize=10;strokeColor=#E65100;fontSize=11;fontColor=#E65100;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;entryX=0;entryY=0.7;" value="&lt;i&gt;[moins de 15 tentatives]&lt;/i&gt;&lt;br&gt;/ réessai différé (délai croissant)">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="185" y="449" />
              <mxPoint x="185" y="170" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- 6 : PROCESSING -> PENDING (reprise crash, boucle externe gauche) -->
        <mxCell id="T6" parent="1" edge="1" source="PROCESSING" target="PENDING" style="html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;endArrow=open;endSize=10;strokeColor=#546E7A;fontSize=11;fontColor=#546E7A;labelBackgroundColor=#FFFFFF;dashed=1;exitX=0;exitY=0.7;entryX=0;entryY=0.3;" value="&lt;b&gt;bloqué &amp;gt; 5 min (redémarrage)&lt;/b&gt;&lt;br&gt;/ remis en attente">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="110" y="342" />
              <mxPoint x="110" y="148" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- ==================== notes ==================== -->
        <mxCell id="N1" parent="1" vertex="1" style="shape=note;whiteSpace=wrap;html=1;size=12;fillColor=#FFFDF5;strokeColor=#37474F;fontSize=10;align=left;spacingLeft=6;spacingRight=6;verticalAlign=middle;" value="Réessai automatique à intervalle croissant — jusqu&#39;à 15 fois (≈ 21,7 h). La boucle repasse par PROCESSING : ce n&#39;est pas une auto-transition.">
          <mxGeometry x="30" y="470" width="230" height="86" as="geometry" />
        </mxCell>
        <mxCell id="N1l" parent="1" edge="1" source="N1" target="CHOICE" style="html=1;endArrow=none;dashed=1;strokeColor=#9E9E9E;" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="N2" parent="1" vertex="1" style="shape=note;whiteSpace=wrap;html=1;size=12;fillColor=#FFFDF5;strokeColor=#37474F;fontSize=10;align=left;spacingLeft=6;spacingRight=6;verticalAlign=middle;" value="File morte : consultable et rejouable par un administrateur (back-office).">
          <mxGeometry x="600" y="520" width="240" height="60" as="geometry" />
        </mxCell>
        <mxCell id="N2l" parent="1" edge="1" source="N2" target="FAILED" style="html=1;endArrow=none;dashed=1;strokeColor=#9E9E9E;" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
