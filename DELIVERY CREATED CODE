@startuml
title Création Livraison 

actor "ERP System" as ERP

box "Event Bus (RabbitMQ)"
    queue "Message Broker" as Broker
end box


' ========= Mapping MS =========
box "Microservice Mapping"
    boundary "Event Listener\n<<interface>>" as MappingListener
    control "MappingService\n<<controller>>" as MappingService
    entity "Canonical Order\n<<entity>>" as CanonicalOrder
    boundary "Event Publisher\n<<interface>>" as MappingPublisher
end box


' ========= Delivery MS =========
box "Microservice Livraison"
    boundary "Event Listener\n<<interface>>" as DeliveryListener
    control "DeliveryController\n<<controller>>" as DeliveryController
    entity "Livraison\n<<entity>>" as Delivery
    boundary "Event Publisher\n<<interface>>" as DeliveryPublisher
end box


' ========= Workflow MS =========
box "Microservice Workflow"
    boundary "Event Listener\n<<interface>>" as WorkflowListener
    control "WorkflowService\n<<controller>>" as WorkflowService
    entity "Workflow Instance\n<<entity>>" as WorkflowInstance
end box


== Processus ==

ERP -> Broker : OrderReadyForDelivery


Broker -> MappingListener : OrderReadyForDelivery
MappingListener -> MappingService : transformToCanonical()

alt Données ERP valides
    MappingService -> CanonicalOrder : create()
    MappingService -> MappingPublisher : CanonicalOrderCreated
    MappingPublisher -> Broker
else Données invalides
    MappingService -> MappingPublisher : MappingRejected
    MappingPublisher -> Broker
end


Broker -> DeliveryListener : CanonicalOrderCreated
DeliveryListener -> DeliveryController : createDelivery()

alt Livraison valide
    DeliveryController -> Delivery : create()
    DeliveryController -> DeliveryPublisher : DeliveryCreated
    DeliveryPublisher -> Broker
else Erreur création livraison
    DeliveryController -> DeliveryPublisher : DeliveryCreationFailed
    DeliveryPublisher -> Broker
end


Broker -> WorkflowListener : DeliveryCreated
WorkflowListener -> WorkflowService : initializeWorkflow()

opt Vérification état initial autorisé
    WorkflowService -> WorkflowInstance : create()
end

@enduml
